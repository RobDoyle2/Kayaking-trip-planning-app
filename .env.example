# Copy to .env for local work. NEVER commit a real .env file.
#
# Stage 1 needs no secrets. The values below are used by later stages and are
# listed here so you know what will be required.

# Which club folder under src/clubs/ to build. Default: ecskc
CLUB=ecskc

# Stage 6 (Claude assistant): server-side only. Set this in your hosting
# provider's environment-variable settings, never in browser code.
# ANTHROPIC_API_KEY=

# Stage 5 (live data): the Marine Institute and Met Eireann feeds need no key.
# Open-Meteo (optional wave forecast) needs no key for non-commercial use.

# Copy to .env for local work. NEVER commit a real .env file.
#
# Stage 1 needs no secrets. The values below are used by later stages and are
# listed here so you know what will be required.

# Which club folder under src/clubs/ to build. Default: ecskc
CLUB=ecskc

# The Claude assistant (api/ask.js): server-side only. Set this in your hosting
# provider's environment-variable settings, never in browser code. Also set a
# monthly spend limit in the Anthropic Console: that is the real cap.
# ANTHROPIC_API_KEY=
# Optional:
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ASSISTANT_ALLOWED_ORIGINS=https://your-club-domain.example
# ASSISTANT_PER_MINUTE=5
# ASSISTANT_PER_HOUR=30
# ASSISTANT_PER_DAY=60
# ASSISTANT_DAILY_LIMIT=400

# Live data is not connected. If it is added later, the Marine Institute tide
# predictions need no key.
